# The toolchain runs inside WSL, so every text file has to check out with LF
# endings or `bash` rejects it with `set: pipefail\r: invalid option name`.
# Without this, `core.autocrlf=true` on a Windows checkout silently rewrites the
# shell scripts and breaks `npm run verify`.
* text=auto eol=lf

# Windows launchers still want CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never be touched by line-ending conversion.
*.png binary
*.webp binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
